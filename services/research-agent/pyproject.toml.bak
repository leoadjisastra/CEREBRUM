[project]
name = "research-agent"
version = "0.1.0"
description = "CEREBRUM Research Agent service"
requires-python = ">=3.10"
dependencies = [
    "anthropic>=0.39.0",
    "python-dotenv>=1.0.0",
]

[tool.setuptools.packages.find]
where = ["src"]

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.ruff.format]
quote-style = "double"

[dependency-groups]
dev = [
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.15.21",
    "mypy>=2.3.0",
    "pre-commit>=4.6.0",
]
[tool.coverage.run]
source = ["src"]
omit = [
    "*/tests/*",
    "*/__init__.py",
]

[tool.coverage.report]
fail_under = 85
show_missing = true
exclude_lines = 

[tool.semantic_release]

branch = "main"

tag_format = "v{version}"

version_toml = [
    "pyproject.toml:project.version"
]

commit_parser = "conventional"

allow_zero_version = true

upload_to_pypi = false

build_command = ""